{
  "extraKnownMarketplaces": {
    "claude-workflow": {
      "source": {
        "source": "github",
        "repo": "CloudAI-X/claude-workflow-v2"
      }
    },
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    }
  },
  "enabledPlugins": {
    "project-starter@claude-workflow": true,
    "ruflo-mods@ruflo": true,
    "ruflo-swarm@ruflo": true,
    "ruflo-console@ruflo": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs pre-bash'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 5000,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Philipp/AppData/Roaming/Python/Python314/Scripts/graphify.exe hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Philipp/AppData/Roaming/Python/Python314/Scripts/graphify.exe hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs post-edit'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs route'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs session-restore'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/auto-memory-hook.mjs import'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Philipp/AppData/Roaming/Python/Python314/Scripts/graphify.exe hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs session-end'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/auto-memory-hook.mjs sync'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs session-end'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs session-end'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 6000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var a='.claude/helpers/hook-handler.cjs post-task'.split(' '),e=process.env,fs=require('fs'),p=require('path'),f;f=p.join(e.CLAUDE_PROJECT_DIR?e.CLAUDE_PROJECT_DIR:'.',a[0]);if(!fs.existsSync(f))f=p.join((e.USERPROFILE?e.USERPROFILE:e.HOME?e.HOME:'.'),a[0]);var r=require('child_process').spawnSync(process.execPath,[f].concat(a.slice(1)),{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "mcp__claude-flow__*"
    ]
  }
}