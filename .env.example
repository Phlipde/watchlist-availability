# TMDB API key (required)
# Get it for free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_key_here

# Letterboxd username (optional but recommended)
# Lets the script fetch your watchlist automatically from your public page,
# with no manual download. Your watchlist must be PUBLIC.
# If left empty, the script uses an exported CSV (watchlist*.csv in Downloads).
LETTERBOXD_USERNAME=your_username

# Country code for streaming availability (ISO 3166-1 alpha-2, default: FR)
# Must match a section in platforms.toml — e.g. FR, US, GB.
COUNTRY=FR
